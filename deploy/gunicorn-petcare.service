# ============================================================
# /etc/systemd/system/gunicorn-petcare.service
# Mantiene Gunicorn corriendo (se reinicia solo y arranca con el servidor).
# Escucha SOLO en 127.0.0.1:8000: desde Internet únicamente se llega por Nginx.
# Django lee su configuración del archivo .env de la carpeta del proyecto.
# ============================================================
[Unit]
Description=Gunicorn de PetCare
After=network.target postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/petcare-eva3
ExecStart=/home/ubuntu/petcare-eva3/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
