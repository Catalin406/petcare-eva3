# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO DE PETCARE
# Copiar a .env (Copy-Item .env.example .env) y completar.
#
# OJO: python-decouple trata una variable PRESENTE pero VACÍA como
# el texto "" y NO usa el valor por defecto. Si quieres el valor por
# defecto, OMITE la línea (o déjala comentada); no escribas "VAR=".
# Para las booleanas usa True/False; para listas, valores separados
# por coma y sin espacios.
# ============================================================

# ---------- Seguridad básica ----------
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ---------- PostgreSQL (único motor soportado) ----------
DB_NAME=petcare_db
DB_USER=petcare
DB_PASSWORD=pon-aqui-tu-clave
DB_HOST=localhost
DB_PORT=5432

# ---------- Sesiones ----------
# Segundos de vida de la sesión (por defecto 1800 = 30 min).
# SESSION_EXPIRA_SEGUNDOS=1800

# ---------- Reglas de negocio ----------
# Anticipación mínima (horas) para que un tutor pida/cancele una cita.
# CITA_ANTICIPACION_MIN_HORAS=24
# Días hacia adelante que mira "generar_recordatorios".
# DIAS_ANTICIPACION_RECORDATORIO=30

# ---------- Correo ----------
# Por defecto imprime los correos en consola. Para SMTP real, define
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y EMAIL_*.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_DESDE=PetCare <no-responder@petcare.local>

# ---------- Datos del estudiante (footer) ----------
ALUMNO_NOMBRE=Catalina Quezada Sanzana
# ALUMNO_SECCION=
# ALUMNO_ANIO=2026

# ---------- Solo en el servidor (detrás de Nginx + HTTPS) ----------
# CSRF_TRUSTED_ORIGINS=https://codelab-catalina.duckdns.org
# DETRAS_DE_PROXY_HTTPS=True
# COOKIES_SEGURAS=True
